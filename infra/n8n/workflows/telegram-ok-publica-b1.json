    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Parse the exact pattern 'ok publica <publication_id>' (case-insensitive,\n// single-line). No network here (Code sandbox forbids it) — only string work.\nconst text = ($json.message && $json.message.text ? String($json.message.text) : '').trim();\nconst m = text.match(/^ok\\s+publica\\s+(\\S+)$/i);\nreturn {\n  json: {\n    matched: Boolean(m),\n    publication_id: m ? m[1] : '',\n    chat_id: $json.message && $json.message.chat ? $json.message.chat.id : null\n  }\n};"
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Parse 'ok publica <id>'",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [80, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "loose", "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "is-matched",
              "leftValue": "={{ $json.matched }}",
              "rightValue": "",
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Matched pattern?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [300, 220]
    },
