        "genericAuthType": "httpBearerAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ ({ task: 'web.publish_editorial_post', input: { publication_id: $json.publication_id, telegram_confirmed: true } }) }}",
        "options": { "timeout": 15000 }
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "POST /enqueue (web.publish_editorial_post)",
