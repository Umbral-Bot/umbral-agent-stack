{
  "name": "B3 — Worker /health cron → alerta Telegram (INACTIVE)",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [{ "field": "minutes", "minutesInterval": 15 }]
        }
      },
      "id": "b3000000-0000-4000-8000-000000000001",
      "name": "Every 15 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [-240, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.WORKER_URL }}/health",
        "options": { "timeout": 10000 }
      },
      "id": "b3000000-0000-4000-8000-000000000002",
      "name": "GET /health",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [-20, 300],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {},
      "id": "b3000000-0000-4000-8000-000000000003",
      "name": "Healthy (no-op, no alert)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [220, 200]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_ALLOWED_CHAT_ID }}",
        "text": "={{ '🔴 Worker /health no responde (VPS). Reintentos agotados. Detalle: ' + ($json.error || $json.message || 'sin respuesta') }}",
        "additionalFields": { "appendAttribution": false }
      },
      "id": "b3000000-0000-4000-8000-000000000004",
      "name": "Alert: Worker /health DOWN",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [220, 400],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_ON_IMPORT",
          "name": "Telegram Bot — Umbral Editorial (TEST)"
        }
      }
    }
  ],
  "connections": {
    "Every 15 min": {
      "main": [[{ "node": "GET /health", "type": "main", "index": 0 }]]
    },
    "GET /health": {
      "main": [
        [{ "node": "Healthy (no-op, no alert)", "type": "main", "index": 0 }],
        [{ "node": "Alert: Worker /health DOWN", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Santiago" },
  "pinData": {},
  "meta": {},
  "tags": []
}
