# --- Notion (Control Room, Dashboard; doc 18, 22) ---
# NOTION_API_KEY=...
# NOTION_CONTROL_ROOM_PAGE_ID=...   # Pagina donde Rick/Enlace comentan; poller lee a las XX:10
# NOTION_DASHBOARD_PAGE_ID=...      # Pagina Dashboard Rick (actualizada por dashboard_report_vps.py)
# NOTION_TASKS_DB_ID=xxx            # Superficie operativa de tareas del stack (notion.upsert_task)
# NOTION_PROJECTS_DB_ID=xxx         # Registro tecnico/operativo de proyectos (notion.upsert_project)
# NOTION_DELIVERABLES_DB_ID=xxx     # Bandeja de revision - Rick (notion.upsert_deliverable). Internal agent outputs only. NOT for commercial proposals.
# NOTION_CURATED_SESSIONS_DB_ID=xxx # DEPRECATED: binding legacy V1 session_capitalizable. Still required by batch script + poller. Do not add new callers.
# NOTION_HUMAN_TASKS_DB_ID=xxx      # DB humana `Registro de Tareas y Proximas Acciones` si se usa separada de NOTION_TASKS_DB_ID
# NOTION_COMMERCIAL_PROJECTS_DB_ID=xxx # DB comercial `Asesorias y Proyectos` si se usa separada de NOTION_PROJECTS_DB_ID
# NOTION_SHORTLIST_DS_ID=xxx        # ID clasico de pagina/DB "Alternativas / Shortlist" (P1 norte editorial), NO el `collection://` data-source id. Poller (P2.1) scan de promocion — requiere ademas NOTION_POLLER_ENABLE_PROMOTE=true.
# NOTION_PUBLICACIONES_DB_ID=xxx    # ID clasico de pagina/DB "Publicaciones". Worker (editorial.promote_shortlist_approval, P2.1) crea/verifica la fila promovida.
# NOTION_POLLER_ENABLE_PROMOTE=false # P2.1: scan de promocion Shortlist Aprobar -> Publicaciones. DEFAULT OFF (fail-closed); solo true/1/yes/on explicito lo habilita.
# NOTION_POLLER_ENABLE_V2_COPY_BRIEF=false # Post-P2.1: Rick produce Copy Blog/LinkedIn/X/Newsletter + Visual brief. DEFAULT OFF (fail-closed); no genera imagenes ni abre gates.
# MAGNIFIC_API_KEY=xxx              # x-magnific-api-key REST (Nano Banana Pro Flash por defecto). Worker (magnific.generate_variants, P2.2). NO configurado aun — bloqueante para produccion.
# NOTION_POLLER_ENABLE_MAGNIFIC=false # P2.2: imagenes despues del HITL del brief. DEFAULT OFF (fail-closed); un Visual brief no vacio es defensa minima, no señal de aprobacion. No habilitar sin el gate futuro y MAGNIFIC_API_KEY.

